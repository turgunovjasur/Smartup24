# ══════════════════════════════════════════════════════════════════════════
# Smartup24 E2E — muhit sozlamalari NAMUNASI
# Nusxa oling:  .env.example  ->  .env   va qiymatlarni to'ldiring.
# .env fayl git'ga TUSHMAYDI (.gitignore'da) — MAXFIY qiymatlar faqat .env da.
# DIQQAT: izohni qiymat yoniga (inline) yozma — python-dotenv uni qiymat deb o'qiydi.
# ══════════════════════════════════════════════════════════════════════════

# ── ERP login (MAXFIY) ─────────────────────────────────────────────────────
# flow_authorization.py shu paroldan foydalanadi (admin va test userlar).
# Berilmasa default "greenwhite". GitHub'ga ochiq parol tushmasligi uchun shu yerda.
TEST_PASSWORD=greenwhite

# ── Ishlash rejimi (maxfiy EMAS) ───────────────────────────────────────────
# Muhit: dev (default) yoki prod.
TEST_ENV=dev

# Brauzer ko'rinishi: HEADLESS=1 yashiradi (fon/CI), bo'sh/0 = ko'rinadi.
# Report brauzerда ochilishi shundan kelib chiqadi (yashirin->ochilmaydi, ko'rinsa->ochiladi).
HEADLESS=

# Odam uchun intuitiv variant — CLI bayroq (env'ni BOSADI, chalkashliksiz):
#   pytest setup --show-browser | --hide-browser      (brauzerni ko'rsat/yashir)
#   pytest setup --open-report  | --no-open-report    (Allure'ni brauzerда och/ochma)

# ── Telegram bot / bildirishnoma (tg_bot_runner.py) ────────────────────────
TG_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz
TG_CHAT_ID=-1001234567890
# Botga buyruq yuborishga RUXSAT etilgan chat(lar), vergul bilan. Berilmasa TG_CHAT_ID.
TG_ADMIN_CHAT_ID=
# Telegram/Allure xabaridagi "Host" yorlig'i. Berilmasa kompyuter nomi ishlatiladi.
HOST_LABEL=Bahriddinov-PC
