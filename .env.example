# Telegram bildirishnoma sozlamalari (conftest.py pytest_sessionfinish uchun).
# Nusxa oling: .env.example -> .env va qiymatlarni to'ldiring.
# .env fayl git'ga TUSHMASLIGI kerak (.gitignore'ga qo'shing).
TG_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz
TG_CHAT_ID=-1001234567890

# tg_bot_runner.py — botga start/stop yozib testlarni masofadan boshqarish uchun.
# Buyruq yuborishga RUXSAT etilgan chat(lar). Berilmasa TG_CHAT_ID ishlatiladi.
# O'zingiz bilan bot DM'idan boshqarmoqchi bo'lsangiz, DM chat_id ni bu yerga yozing
# (vergul bilan bir nechta bo'lishi mumkin).
TG_ADMIN_CHAT_ID=

# Telegram/Allure xabaridagi "Host" nomi. Berilmasa kompyuterning Windows nomi
# (masalan "sm24-akmal-hr") ishlatiladi. Windows nomini o'zgartirmasdan bu yerda
# istalgan yorliq qo'yish mumkin, masalan: HOST_LABEL=Bahriddinov-PC
HOST_LABEL=
